# ==============================================================================
# EarningsPulse - Environment Variables Template
# Copy this file to .env for local development or configure in Vercel Dashboard
# ==============================================================================

# --- Backend AI Model Keys ---
# NVIDIA NIM API Key for Nemotron reasoning and risk routing
NVIDIA_API_KEY=nvapi-your-nvidia-key-here

# Google Gemini API Key for real-time Google Search Grounding retrieval
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere


# (Optional) NVIDIA Model Configuration
NVIDIA_MODEL=mistralai/mistral-nemotron
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Frontend Auth0 Configuration (Must be prefixed with VITE_) ---
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=yourAuth0ClientIdHere

